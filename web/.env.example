# Copy to .env.local and fill in. Never commit the real .env.local.

# --- Supabase (Postgres + pgvector), free tier ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://**********.supabase.co
# Anon/public key — safe for the browser, respects Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only (Route Handlers/Server Actions), bypasses
# RLS. Do NOT prefix with NEXT_PUBLIC_. Used for the Q&A retrieval query.
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings provider (server-side, used to embed the user's question) --
# Mirrors ingest/.env.example — see providers/embeddings.ts.
EMBEDDINGS_PROVIDER=cloudflare_bge
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDINGS_MODEL=@cf/baai/bge-base-en-v1.5

# Gemini embeddings (fallback: EMBEDDINGS_PROVIDER=gemini — manual config
# flip, not automatic failover). Uses GEMINI_API_KEY below, truncated to
# 768 dims to match Cloudflare bge.
GEMINI_EMBEDDINGS_MODEL=gemini-embedding-001

# --- Generation provider (server-side, used to synthesize the cited answer) -
# Mirrors ingest/.env.example — see providers/generation.ts.
GENERATION_PROVIDER=gemini_flash
GEMINI_API_KEY=
# gemini-2.0-flash was retired API-wide (a real 404 "no longer available",
# caught while building /api/ask — the Generative Language API itself now
# points to the 3.x Flash line); this is the current free-tier Flash.
GEMINI_MODEL=gemini-3.6-flash

# Automatic mid-request failover: when the primary generation provider fails
# (notably Gemini's ~20/day free-tier cap — a real 429 RESOURCE_EXHAUSTED, see
# ingest/NOTES.md), /api/ask fails over to this provider so answers keep
# streaming; if it too fails, the route serves the cited passages extractively.
# Unset = no failover. "cloudflare" reuses the CLOUDFLARE_* creds above with a
# free Workers AI text model.
GENERATION_FALLBACK_PROVIDER=cloudflare
CLOUDFLARE_GENERATION_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- Hybrid retrieval (POST /api/search, match_chunks_hybrid RPC) ----------
# Mirrors ingest/.env.example exactly — see supabase/migrations/*_match_chunks_hybrid.sql
# and ingest/NOTES.md for the vector-only vs. hybrid comparison these
# defaults came from. Defaults only: /api/search's request body can still
# override top_k per-request, but NOT fusion_weight (env-only, like every
# other provider/model choice in this project — a request-level override
# isn't needed and would make results harder to reproduce).
# fusion_weight in [0,1]: 1.0 = vector-only, 0.0 = keyword-only, 0.5 = equal
# weight (reciprocal rank fusion, not a raw score blend — see the migration).
HYBRID_FUSION_WEIGHT=0.5
HYBRID_TOP_K=10

# --- Cited Q&A (POST /api/ask) ---------------------------------------------
# How many chunks to retrieve as grounding context per question. Tuned via
# eval/smoke.py: 8 covers the short concall docs well; the one retrieval miss
# it found (a fact buried in a topically-mixed chunk) isn't reachable by any
# practical top_k, so raising it just adds tokens. See ingest/NOTES.md
# "Smoke eval and tuning".
ASK_TOP_K=8
# Confidence gate: if the single best chunk's cosine similarity is below
# this, /api/ask refuses with "not found in the covered filings" WITHOUT
# calling the LLM. STRONGLY PROVIDER-DEPENDENT and MEASURED (eval/smoke.py):
# for the pinned bge, answerable questions floor at ~0.72 while off-topic
# sits at 0.61-0.72, so the gap is razor-thin. 0.60 is a conservative
# backstop (won't false-refuse real questions); the LLM grounding gate does
# the real refusing. 0.65-0.70 is the aggressive, generation-call-saving
# alternative. See the constant's comment in src/app/api/ask/route.ts.
ASK_SIMILARITY_THRESHOLD=0.60
