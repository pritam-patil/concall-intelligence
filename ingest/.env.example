# Copy to .env and fill in. Never commit the real .env.

# --- Supabase (Postgres + pgvector), free tier ---------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key — server-side only, bypasses RLS. Used by the ingestion
# pipeline to write, never exposed to the web app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings provider ---------------------------------------------------
# Selects the implementation in ingest/providers/embeddings.py.
EMBEDDINGS_PROVIDER=cloudflare_bge

# Cloudflare Workers AI (pinned default: bge-base-en-v1.5, free tier).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDINGS_MODEL=@cf/baai/bge-base-en-v1.5

# Gemini embeddings (fallback: EMBEDDINGS_PROVIDER=gemini — manual, not
# automatic failover; see ingest/README.md's "Embedding" section). Uses
# GEMINI_API_KEY below, truncated to 768 dims to match Cloudflare bge.
GEMINI_EMBEDDINGS_MODEL=gemini-embedding-001

# --- Generation provider ----------------------------------------------------
# Selects the implementation in ingest/providers/generation.py.
GENERATION_PROVIDER=gemini_flash

# Gemini (pinned default: Flash, free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- NSE source ---------------------------------------------------------
NSE_BASE_URL=https://www.nseindia.com
